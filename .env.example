# Database connection string or DATABASE_URL
DB_CONNECTION_STRING=Host=<host>;Port=<port>;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
# Or use a full connection URI
# DATABASE_URL=postgres://user:password@host:port/database

# JWT settings
JWT_SECRET=your-strong-secret-key-with-at-least-32-characters
JWT_ISSUER=MyCarApp
JWT_AUDIENCE=MyCarAppUsers
JWT_EXPIRY_IN_DAYS=7

# Cloudinary settings
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>
